# Uddomi Client (Next.js) Environment Variables
# -------------------------------------------

# Public URL of the deployed Express backend (e.g. https://uddomi--server-.vercel.app)
# Leave empty in local full-stack mode when using Next.js rewrites to 127.0.0.1:4000.
NEXT_PUBLIC_API_URL=""

# Optional: Public Better Auth base URL (defaults to NEXT_PUBLIC_API_URL when set, or same-origin)
NEXT_PUBLIC_BETTER_AUTH_URL=""

# Server-side Next.js rewrite target when proxying /api/* to the deployed Express backend on Vercel
API_BACKEND_URL=""

# MongoDB Atlas Connection URI & Database Name
MONGODB_URI=""
MONGODB_DB_NAME="goodgather"

# Better Auth Secret (must match server BETTER_AUTH_SECRET, minimum 32 random characters)
BETTER_AUTH_SECRET="replace_with_a_cryptographically_random_secret_min_32_characters"

# Canonical Client URL & Trusted Origins (for same-origin Next.js auth & OAuth callbacks)
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://your-client.vercel.app"

# GitHub OAuth Credentials (Authorized Callback URL: <AUTH_URL>/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

